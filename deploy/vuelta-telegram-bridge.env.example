# Install as /etc/vuelta/telegram-bridge.env with mode 0600. Replace every
# placeholder locally; never commit the installed file or real values.
VUELTA_TELEGRAM_BOT_TOKEN=replace-with-bot-token
VUELTA_TELEGRAM_CHAT_ID=replace-with-private-chat-id
VUELTA_TELEGRAM_USER_ID=replace-with-allowed-user-id
