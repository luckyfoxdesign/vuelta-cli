[Unit]
Description=Vuelta zero-edit release synchronization
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=vuelta-deploy
Group=vuelta-deploy
SupplementaryGroups=docker
ExecStart=/usr/local/bin/vuelta --no-input --config /etc/vuelta/config.yaml deploy sync --json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/vuelta
# Add every configured workspace parent here. Vuelta reads project Git and
# Compose metadata but never writes into a managed repository.
ReadOnlyPaths=/srv/projects
ReadWritePaths=/var/lib/vuelta
