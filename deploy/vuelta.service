[Unit]
Description=Vuelta dependency scan and snapshot updates

[Service]
Type=oneshot
User=vuelta
Group=vuelta
ExecStart=/usr/local/bin/vuelta-scheduler --vuelta /usr/local/bin/vuelta --failure-policy continue --findings-policy report
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/vuelta %h/.local/state/vuelta
