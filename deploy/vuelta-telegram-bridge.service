[Unit]
Description=Vuelta SQLite-backed Telegram bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Use the owner of /var/lib/vuelta so SQLite remains 0600. Unlike the deploy
# worker unit, this process receives no docker supplementary group.
User=vuelta-deploy
Group=vuelta-deploy
EnvironmentFile=/etc/vuelta/telegram-bridge.env
ExecStart=/usr/local/bin/vuelta-telegram-bridge --database /var/lib/vuelta/history.db
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/vuelta
ReadWritePaths=/var/lib/vuelta
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock -/srv/projects
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
